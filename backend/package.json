{
  "name": "alfa-gestao-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "node scripts/check-syntax.js",
    "db:migrate": "node scripts/migrate.js",
    "db:create-migration": "node-pg-migrate create",
    "db:rollback": "node -e \"throw new Error('Rollback exige plano administrativo explicito')\"",
    "db:seed:admin": "node src/database/seed-admin.js",
    "test": "node scripts/verify-local.js",
    "db:provision": "node scripts/provision-passwords.js",
    "db:seed:tenant-b": "node src/database/seed-tenant-b.js",
    "test:gate": "node scripts/gate.js",
    "test:local": "node scripts/verify-local.js",
    "db:audit": "node scripts/audit-db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "uuid": "^11.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
